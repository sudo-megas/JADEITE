{
  "compilerOptions": {
    "target": "ES2022",
    // Playwright specs straddle two worlds: the spec body runs in Node, while
    // page.evaluate callbacks are serialised and run inside the renderer.
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["tests/e2e/**/*.ts", "src/shared/**/*.ts", "src/preload/api.d.ts"]
}
